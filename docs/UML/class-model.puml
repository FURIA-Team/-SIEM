@startuml
skinparam classAttributeIconSize 0
package "контроллер" {
 class AuthController
 class SecurityOperationsController
 class HomeController
}
package "сервис" {
 class AuthService
 class SecurityOperationsService
}
package "репозиторий" {
 interface UserRepository
 interface SecurityEventRepository
 interface SecurityAlertRepository
 interface SystemLogRepository
 interface SystemSettingsRepository
}
package "нысан" {
 class User
 class SecurityEvent
 class SecurityAlert
 class SystemLog
 class SystemSettings
}
class SecurityConfig
AuthController --> AuthService
SecurityOperationsController --> SecurityOperationsService
AuthService --> UserRepository
AuthService --> SystemLogRepository
SecurityOperationsService --> UserRepository
SecurityOperationsService --> SecurityEventRepository
SecurityOperationsService --> SecurityAlertRepository
SecurityOperationsService --> SystemLogRepository
SecurityOperationsService --> SystemSettingsRepository
UserRepository ..> User
SecurityEventRepository ..> SecurityEvent
SecurityAlertRepository ..> SecurityAlert
SystemLogRepository ..> SystemLog
SystemSettingsRepository ..> SystemSettings
SecurityAlert --> "eventId: Long" SecurityEvent : логикалық сілтеме
note on link
  Бірегей eventId өрісі;
  JPA байланысы емес.
end note
@enduml
