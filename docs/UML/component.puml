@startuml
skinparam componentStyle rectangle
actor "Браузер"
component "Веб-интерфейс\nHTML / CSS / JavaScript" as UI
component "Spring MVC\nКонтроллерлер" as C
component "DTO + деректерді тексеру" as DTO
component "Сервис қабаты" as S
component "Spring Data JPA\nРепозиторийлер" as R
component "Spring Security\nSecurityConfig" as SEC
database "SQLite" as DB
"Браузер" --> UI
UI --> SEC : HTTP сессия / CSRF
UI --> C : REST API
C --> DTO
C --> S
S --> R
R --> DB
SEC ..> C : қолжетімділікті тексеру
@enduml
