@startuml
actor Пайдаланушы
participant "Браузер / API клиенті" as Client
participant "Spring Security" as Security
participant "SecurityOperationsController" as Controller
participant "SecurityOperationsService" as Service
database "SQLite" as DB
Пайдаланушы -> Client : Оқиғаны жіберу
Client -> Security : POST /api/user/events + session + CSRF
Security -> Security : Сессияны, рөлді, CSRF тексеру
Security -> Controller : Сұранысты беру
Controller -> Service : createEvent(request, actor)
Service -> DB : SecurityEvent сақтау
alt severity = HIGH немесе CRITICAL
  Service -> DB : SecurityAlert(eventId) сақтау
else severity = MEDIUM немесе LOW
  Service -> Service : Автоматты ескерту жасамау
end
Service --> Controller : EventResponse
Controller --> Client : HTTP 201 + JSON
@enduml
